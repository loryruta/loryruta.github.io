    <script>
        function setAttributeRecursive(el, attr, val) {
            if (el.tagName !== 'svg') {
                el.style[attr] = val;
            }
            el.querySelectorAll("*").forEach(child => {
                child.style[attr] = val;
                
            });
        }

        async function setDiagram(templateId, targetId, nodesToHighlight) {
            // Reference:
            // https://github.com/zjffun/reveal.js-mermaid-plugin/blob/898a6587e75d54a060f27075af1cdf06fd48d2aa/plugin/mermaid/plugin.js#L32-L37
            
            let mermaidCode = document.getElementById(templateId).innerHTML;
            mermaidCode = mermaidCode.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
            const targetDiv = document.getElementById(targetId);
            const { svg: svgCode } = await mermaid.render(`mermaid-${Math.random().toString(36).substring(2)}`, mermaidCode);
            targetDiv.innerHTML = svgCode;

            for (let nodeId of nodesToHighlight) {
                setAttributeRecursive(document.querySelector(`#${targetId} #${nodeId}`), "stroke", "red");
                setAttributeRecursive(document.querySelector(`#${targetId} #${nodeId}`), "stroke-width", "3px");
            }
        }
    </script>
